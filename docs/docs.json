          "concepts/cost",
          "concepts/artifact-store"
        ]
      },
      {
        "group": "Architecture",
        "pages": [
          "architecture/overview",
          "architecture/run-lifecycle",
          "architecture/leases",
          "architecture/data-model",
          "architecture/state-machines",
          "architecture/code-layout",
          "architecture/extension-points"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/running-for-days",
          "guides/secrets",
          "guides/remote-workers",
          "guides/mcp-servers",
          "guides/upgrading",
          "guides/watch",
