    "/v1/events": {
      "get": {
        "summary": "Events",
        "description": "The events after a cursor. With wait, it answers once an event matches, or at the end of the wait with none.\n\nEach read runs in the thread pool, in a session of its own. Between two reads the route awaits the database's\nnext wake and holds no thread. Each read starts at the cursor that the last one moved to, past what the filters\nleft out.",
        "operationId": "events",
        "parameters": [
          {
            "name": "campaign",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The campaign's name, or a path inside its repo.",
              "title": "Campaign"
            },
            "description": "The campaign's name, or a path inside its repo."
          },
          {
            "name": "cwd",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Where the client runs, as an absolute path: a relative path in ``campaign`` is from there.",
              "title": "Cwd"
            },
            "description": "Where the client runs, as an absolute path: a relative path in ``campaign`` is from there."
          },
          {
            "name": "wait",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 25,
              "minimum": 0,
              "description": "Seconds to hold the request while there is nothing to answer yet.",
              "default": 0,
              "title": "Wait"
            },
            "description": "Seconds to hold the request while there is nothing to answer yet."
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "The cursor to read after: the ``next`` of the last read, or the ``cursor`` of a snapshot.",
              "default": 0,
              "title": "After"
            },
            "description": "The cursor to read after: the ``next`` of the last read, or the ``cursor`` of a snapshot."
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Only the events of these kinds.",
              "default": [],
              "title": "Kind"
            },
            "description": "Only the events of these kinds."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "description": "The most events to answer.",
              "default": 100,
              "title": "Limit"
            },
            "description": "The most events to answer."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Batch"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
