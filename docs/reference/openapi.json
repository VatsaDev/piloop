  "components": {
    "schemas": {
      "Batch": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/Envelope"
            },
            "type": "array",
            "title": "Events"
          },
          "next": {
            "type": "integer",
            "title": "Next",
            "description": "The cursor for the next read. It passes every event that the read examined, those that the filters left out\ntoo, so a read that returns nothing still moves on."
          },
          "more": {
            "type": "boolean",
            "title": "More",
            "description": "Events newer than ``next`` exist already: read again without waiting. They may not match the filters."
          }
        },
        "type": "object",
        "required": [
          "events",
          "next",
          "more"
        ],
        "title": "Batch",
        "description": "The result of a read."
      },
