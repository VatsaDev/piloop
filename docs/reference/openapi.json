    "/v1/events": {
      "get": {
        "summary": "Events",
        "description": "The events after a cursor. With wait, it answers once an event matches, or at the end of the wait with none.",
        "operationId": "events",
        "parameters": [
          {
            "name": "campaign",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The campaign's name, or a path inside its repo.",
